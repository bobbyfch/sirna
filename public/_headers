# These headers apply to static assets served by Cloudflare Workers.
# CSP untuk Sirna (Vite): Tailwind + JSZip sekarang dibundel lokal — tidak
# ada lagi origin eksternal yang dipakai halaman. Inline script tema (head)
# + atribut style masih dipakai, jadi 'unsafe-inline' diperlukan untuk
# script-src dan style-src. blob: di img-src/media-src untuk pratinjau file
# via URL.createObjectURL, data: untuk favicon SVG inline.
#
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://huggingface.co https://*.cdn.hf.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
