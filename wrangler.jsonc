{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "compatibility_date": "2026-10-28",
  "name": "sirna",
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "sirna.limaraya.com"
    }
  ],
  "workers_dev": false
}
